# ----------------------------------------------------------------------------
# RO-IPTV configuration — copy to ".env" and edit as needed.
# ----------------------------------------------------------------------------

# Port the app (API + PWA frontend) listens on. Access at http://localhost:56892
PORT=56892

# Timezone for the container (affects clock / EPG times)
TZ=Europe/London

# Optional: auto-load this M3U/M3U8 playlist on first launch.
# Leave blank to add playlists from the UI (Settings) instead.
M3U_URL=

# Optional: XMLTV EPG URL used for the programme guide and Now/Next labels.
EPG_URL=

# How often (in minutes) the active playlist auto-refreshes. 0 = disabled.
REFRESH_INTERVAL_MINUTES=360

# Maximum length of a single recording, in minutes. A capture auto-stops at this
# cap (protects disk from runaway live recordings). Recordings are stored in the
# /data volume and persist across restarts/rebuilds.
RECORDING_MAX_MINUTES=180
# Concurrent captures; excess immediate starts return 503 and scheduled jobs fail
# with a capacity error. Positive integer; no implicit unlimited mode.
RECORDING_MAX_CONCURRENT=4
# Stop stalled/no-progress input after this many seconds (positive finite).
RECORDING_INPUT_IDLE_SECONDS=30

# Optional: total-storage cap for recordings, in gigabytes. When set and exceeded,
# the server prunes the OLDEST finished recordings (never an active capture) before
# each scheduled capture starts. Leave blank/0 for no cap. Example: 20
RECORDINGS_MAX_GB=

# Comma-separated domains/origins allowed to call the API from another origin.
# The app itself is same-origin, so leaving this EMPTY (allow any) is fine for
# most setups. Set it to lock the API down to known hosts. Entries can be a host,
# host:port, or full origin, with or without scheme. Examples:
#   CORS_ALLOWED_ORIGINS=tv.example.com
#   CORS_ALLOWED_ORIGINS=192.168.0.10:56892,tv.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Authentication (§4)
# ----------------------------------------------------------------------------
# Compose: unset defaults to admin; this example explicitly selects admin.
# Explicit empty opens ONLY a fresh data directory. A stored credential always
# keeps authentication enabled, regardless of the bootstrap environment.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# How many days a "Remember Password" session stays valid. Without it ticked the
# session lasts only until the browser is closed.
AUTH_SESSION_DAYS=30
# Optional: pin the session-signing secret. If empty, one is generated and stored
# in the /data volume. Setting/rotating this invalidates all existing sessions.
AUTH_SESSION_SECRET=
# Max login attempts per IP per 15 minutes (brute-force protection).
RL_LOGIN_MAX=10

# ----------------------------------------------------------------------------
# Security hardening (§2/§4) — all optional, sensible defaults.
# ----------------------------------------------------------------------------

# Reverse-proxy hops in front of the app (Express "trust proxy"). 0/empty = none.
# Set 1 behind nginx/Caddy/Traefik so the real client IP is rate-limited and the
# session cookie is marked Secure over HTTPS.
TRUST_PROXY=

# HSTS max-age in seconds (sent to browsers; only honored over HTTPS). Default 180d.
HSTS_MAX_AGE=15552000

# API rate limiting. Applies ONLY to upstream-fetch + write endpoints — playback,
# media streaming and polled list GETs are never throttled. Set RATE_LIMIT_DISABLED=1
# to turn limiting off entirely. Maxes are per-client-IP per minute.
RATE_LIMIT_DISABLED=
RL_UPSTREAM_MAX=120
RL_WRITE_MAX=120

# Outbound trust policy: blank = intentionally trusted LAN sources; 1 = strict
# public destinations with every DNS answer checked and the connection pinned.
# Strict mode also covers recording redirects, HLS playlists, keys and segments.
PROXY_BLOCK_PRIVATE=
# Optional explicit LAN exceptions in strict mode, comma-separated CIDRs, e.g.
# 192.168.1.0/24,fd12:3456::/48. Keep these scoped to networks you trust.
# Invalid CIDRs stop startup. An enabled exact EPG_SIDECAR_URL is exempt;
# that exception never extends to a redirect, hostname, or sibling path.
PROXY_ALLOWED_CIDRS=

# Container runtime limits (docker-compose.yml). Keep generous: EPG decompression
# can use ~600MB transiently, so don't set MEM_LIMIT too low.
MEM_LIMIT=2g
CPU_LIMIT=2
PIDS_LIMIT=256
NOFILE_SOFT=4096
NOFILE_HARD=8192

# Node's heap ceiling inside the container (MB). Keep it below MEM_LIMIT: this bounds
# the JS heap only, while MEM_LIMIT bounds the whole container.
NODE_HEAP_MB=1536

# ----------------------------------------------------------------------------
# Optional sidecar: docker compose -f docker-compose.yml -f docker-compose.epg.yml up -d
# ----------------------------------------------------------------------------
# Base manifests keep this off. The explicit overlay sets enabled=1 and defaults
# the URL to http://epg:3000/guide.xml. For an externally managed peer, set both
# enabled=1 and a valid HTTP(S) URL yourself. A URL alone never enables work.
EPG_SIDECAR_ENABLED=0
EPG_SIDECAR_URL=
# REQUIRED for the grabber: it loads the whole iptv-org dataset before fetching
# anything and dies with "JavaScript heap out of memory" below this.
EPG_HEAP_MB=8192
# Nightly grab (cron). Days ahead to fetch, and how many sites at once.
EPG_CRON_SCHEDULE=0 3 * * *
EPG_DAYS=3
EPG_MAX_CONNECTIONS=1
