# ----------------------------------------------------------------------------
# RO-IPTV configuration — copy to ".env" and edit as needed.
# ----------------------------------------------------------------------------

# Port the app (API + PWA frontend) listens on. Access at http://localhost:56892
PORT=56892

# Timezone for the container (affects clock / EPG times)
TZ=Europe/London

# Optional: auto-load this M3U/M3U8 playlist on first launch.
# Leave blank to add playlists from the UI (Settings) instead.
M3U_URL=

# Optional: XMLTV EPG URL used for the programme guide and Now/Next labels.
EPG_URL=

# How often (in minutes) the active playlist auto-refreshes. 0 = disabled.
REFRESH_INTERVAL_MINUTES=360

# Maximum length of a single recording, in minutes. A capture auto-stops at this
# cap (protects disk from runaway live recordings). Recordings are stored in the
# /data volume and persist across restarts/rebuilds.
RECORDING_MAX_MINUTES=180

# Comma-separated domains/origins allowed to call the API from another origin.
# The app itself is same-origin, so leaving this EMPTY (allow any) is fine for
# most setups. Set it to lock the API down to known hosts. Entries can be a host,
# host:port, or full origin, with or without scheme. Examples:
#   CORS_ALLOWED_ORIGINS=tv.example.com
#   CORS_ALLOWED_ORIGINS=192.168.0.10:56892,tv.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Authentication (Security.md §4)
# ----------------------------------------------------------------------------
# Require a login to use the app. Authentication is ENABLED when AUTH_PASSWORD is
# set, and DISABLED (open) when it is left empty. Choose a long, unique password.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# How many days a "Remember Password" session stays valid. Without it ticked the
# session lasts only until the browser is closed.
AUTH_SESSION_DAYS=30
# Optional: pin the session-signing secret. If empty, one is generated and stored
# in the /data volume. Setting/rotating this invalidates all existing sessions.
AUTH_SESSION_SECRET=
# Max login attempts per IP per 15 minutes (brute-force protection).
RL_LOGIN_MAX=10

# ----------------------------------------------------------------------------
# Security hardening (Security.md §2/§4) — all optional, sensible defaults.
# ----------------------------------------------------------------------------

# HSTS max-age in seconds (sent to browsers; only honored over HTTPS). Default 180d.
HSTS_MAX_AGE=15552000

# API rate limiting. Applies ONLY to upstream-fetch + write endpoints — playback,
# media streaming and polled list GETs are never throttled. Set RATE_LIMIT_DISABLED=1
# to turn limiting off entirely. Maxes are per-client-IP per minute.
RATE_LIMIT_DISABLED=
RL_UPSTREAM_MAX=120
RL_WRITE_MAX=120

# Container runtime limits (docker-compose.yml). Keep generous: EPG decompression
# can use ~600MB transiently, so don't set MEM_LIMIT too low.
MEM_LIMIT=1024m
CPU_LIMIT=2
PIDS_LIMIT=256
NOFILE_SOFT=4096
NOFILE_HARD=8192
